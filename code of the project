#include <LoRa.h>
#include <SoftwareSerial.h>
#include <ESP8266WiFi.h>
#include <BlynkSimpleEsp8266.h>

char auth [] = "YourBlynkToken";
char ssid [] = "YourWiFiSSID";
char pass [] = "YourWiFiPassword";

SoftwareSerial sim800(D5, D6); // RX, TX for GSM
String lastMessage = "";

BlynkTimer timer;

void setup () {
  Serial.begin(9600);
  sim800.begin(9600);
  Blynk.begin(auth, ssid, pass);

  LoRa.begin(433E6); // Set LoRa frequency to 433 MHz
  timer.setInterval (1000L, checkLoRa); // Check LoRa every second
}

void loop () {
  Blynk.run (); // Handle Blynk tasks
  timer.run (); // Execute timed tasks
}

void checkLoRa() {
  int packetSize = LoRa.parsePacket();
  if (packetSize) {
    String msg = "";
    while (LoRa.available()) {
      msg += (char)LoRa.read();
    }

    Serial.println("Received: " + msg);
    Blynk.virtualWrite(V0, "YES"); // Set virtual pin V0 to "YES"
    Blynk.virtualWrite(V1, msg); // Display received message on Blynk

    sendSMS(msg); // Send the received message via SMS
  }
}

void sendSMS (String text) {
  sim800.println("AT+CMGF=1"); // Set SMS format to text mode
  delay (1000);
  sim800.println("AT+CMGS=\"+91xxxxxxxxxx\""); // Replace with the recipient's phone number
  delay (1000);
  sim800.println("⚠️ Accident Alert! \n" + text); // SMS body
  sim800.write(26); // Send the message (CTRL+Z)
  delay (2000); // Wait for SMS to be sent
}

